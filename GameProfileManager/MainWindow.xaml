<Window x:Class="GameProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Profile Manager" Width="1360" Height="860" MinWidth="1100" MinHeight="690"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/GameProfileManager;component/Assets/app-icon.png"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="29"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="NavTab" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="11" Padding="15,13" Margin="0,1" SnapsToDevicePixels="False">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1D2A32"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#25362D"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ProfileItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="Padding" Value="14,13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Background="#1A2530" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#243240"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#273A2F"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#5B8C50"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <TabControl BorderThickness="0" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" ItemContainerStyle="{StaticResource NavTab}" TabStripPlacement="Left">
    <TabControl.Template>
      <ControlTemplate TargetType="TabControl">
        <Grid Background="{TemplateBinding Background}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="23,27,20,35">
                <StackPanel Orientation="Horizontal">
                  <Image Source="pack://application:,,,/GameProfileManager;component/Assets/app-icon.png" Width="38" Height="38" Margin="0,0,11,0"/>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GAME" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="PROFILE MANAGER" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"/>
                  </StackPanel>
                </StackPanel>
                <TextBlock Text="РАБОЧАЯ ОБЛАСТЬ" Foreground="#718494" FontSize="10" FontWeight="Bold" Margin="3,48,0,0"/>
              </StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="23,0,20,23">
                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,18"/>
                <TextBlock Text="Локальные профили для ваших игр" Style="{StaticResource Muted}" FontSize="11"/>
                <TextBlock Text="WINDOWS 11  ·  DESKTOP" Foreground="#718494" FontSize="9" FontWeight="SemiBold" Margin="0,8,0,0"/>
              </StackPanel>
              <StackPanel IsItemsHost="True" Margin="14,0" KeyboardNavigation.TabIndex="1"/>
            </DockPanel>
          </Border>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,0,1" Padding="32,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="GAME PROFILE MANAGER" Style="{StaticResource Eyebrow}" FontSize="10"/>
                  <TextBlock Text="Управление производительностью" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
                  <Button Content="Проверить" Command="{Binding VerifyCommand}" Margin="0,0,8,0"/>
                  <Button Content="Применить ко всем  ↗" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"/>
                </StackPanel>
              </Grid>
            </Border>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="32,24,32,20"/>
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="32,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,11,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Notice}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </ControlTemplate>
    </TabControl.Template>

    <TabItem Header="Обзор" Tag="01">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border CornerRadius="19" BorderBrush="#3A5141" BorderThickness="1" Padding="29" Margin="0,0,0,20">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#233A2C" Offset="0"/>
                <GradientStop Color="#182A29" Offset="0.55"/>
                <GradientStop Color="#17232D" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="ВАШ ИГРОВОЙ КОНТРОЛЬНЫЙ ЦЕНТР" Style="{StaticResource Eyebrow}" Margin="0,0,0,14"/>
                <TextBlock Text="Игры. Настроены." FontSize="36" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Один профиль задаёт FPS, G-SYNC и V-Sync для всех назначенных игр. Примените настройки заранее и запускайте игру как обычно." Style="{StaticResource Muted}" FontSize="14" MaxWidth="610" HorizontalAlignment="Left" Margin="0,0,0,23"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Применить профили  ↗" Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}" Margin="0,0,9,0"/>
                  <Button Content="Проверить настройки" Command="{Binding VerifyCommand}"/>
                </StackPanel>
              </StackPanel>
              <Grid Grid.Column="1" Width="168" Height="168" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Stroke="#537452" StrokeThickness="1"/>
                <Ellipse Width="130" Height="130" Stroke="#7DA76A" StrokeThickness="1" Opacity="0.75"/>
                <Ellipse Width="90" Height="90" Fill="#B9EF72"/>
                <TextBlock Text="GPM" Foreground="#17240F" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>
          <UniformGrid Columns="3" Margin="0,0,-15,19">
            <Border Style="{StaticResource Card}" Margin="0,0,15,0">
              <StackPanel>
                <TextBlock Text="ИГРЫ В БИБЛИОТЕКЕ" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding GameCount}" FontSize="39" FontWeight="SemiBold" Margin="0,13,0,1"/>
                <TextBlock Text="Добавленные .exe и игры Steam" Style="{StaticResource Muted}" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,15,0">
              <StackPanel>
                <TextBlock Text="ПРОФИЛИ" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding ProfileCount}" FontSize="39" FontWeight="SemiBold" Margin="0,13,0,1"/>
                <TextBlock Text="Общие наборы настроек" Style="{StaticResource Muted}" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,15,0">
              <StackPanel>
                <TextBlock Text="ТРЕБУЮТ ВНИМАНИЯ" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding ErrorCount}" FontSize="39" FontWeight="SemiBold" Margin="0,13,0,1"/>
                <TextBlock Text="Ошибки и ограничения" Style="{StaticResource Muted}" FontSize="12"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="ИНТЕГРАЦИИ" Style="{StaticResource Eyebrow}" Margin="0,0,0,20"/>
                <TextBlock Text="NVIDIA" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding NvidiaStatus}" Style="{StaticResource Muted}" Margin="0,5,0,17"/>
                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,17"/>
                <TextBlock Text="RivaTuner Statistics Server" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding RtssStatus}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="КАК ЭТО РАБОТАЕТ" Style="{StaticResource Eyebrow}" Margin="0,0,0,20"/>
                <TextBlock Text="1   Создайте или выберите профиль" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <TextBlock Text="2   Назначьте его игровому .exe" FontWeight="SemiBold" Margin="0,0,0,13"/>
                <TextBlock Text="3   Примените настройки и играйте" FontWeight="SemiBold" Margin="0,0,0,19"/>
                <TextBlock Text="Последняя синхронизация" Style="{StaticResource Muted}" FontSize="12"/>
                <TextBlock Text="{Binding LastSync}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
          <TextBlock Text="Статус «Применён» подтверждает сохранённые значения. Фактическую активацию VRR во время игры приложение не измеряет." Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,3"/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Мои игры" Tag="02">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="БИБЛИОТЕКА" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
            <TextBlock Text="Мои игры" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Назначайте профили игровым процессам и проверяйте их состояние." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="Импорт Steam" Command="{Binding ImportSteamCommand}" Margin="0,0,8,0"/>
            <Button Content="+ Добавить .exe" Style="{StaticResource PrimaryButton}" Command="{Binding AddGameCommand}"/>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
          <Grid Margin="0,0,10,0">
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по названию игры или пути"/>
            <TextBlock Text="Поиск по названию игры или пути" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
          <Grid>
          <DataGrid x:Name="GamesGrid" ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}" AlternationCount="2" Margin="16,10,16,12">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="ИГРА / ИСПОЛНЯЕМЫЙ ФАЙЛ" Width="2.4*" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                      <Border Width="38" Height="38" Background="#253440" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                        <Grid>
                          <Canvas Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M 4,11 C 5,8 7,7 10,7 L 15,7 C 18,7 20,8 21,11 L 23,17 C 23.5,19.5 21,20.5 19,18.5 L 16.5,16 L 8.5,16 L 6,18.5 C 4,20.5 1.5,19.5 2,17 Z" Stroke="#A5C3B5" StrokeThickness="1.5" Fill="#2B4249"/>
                            <Path Data="M 7,11 L 12,11 M 9.5,8.5 L 9.5,13.5" Stroke="#A5C3B5" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="15.5" Canvas.Top="10" Width="2" Height="2" Fill="#C9DFAC"/>
                            <Ellipse Canvas.Left="18.5" Canvas.Top="12.5" Width="2" Height="2" Fill="#C9DFAC"/>
                          </Canvas>
                          <Image Source="{Binding Icon}" Width="38" Height="38" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image.Clip><RectangleGeometry Rect="0,0,38,38" RadiusX="8" RadiusY="8"/></Image.Clip>
                          </Image>
                        </Grid>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="380" ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding ExeDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,2,0,0" ToolTip="{Binding ExeDisplay}"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ПРОФИЛЬ" Width="1.35*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox ItemsSource="{Binding DataContext.ProfileOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValuePath="Id" SelectedValue="{Binding ProfileSelectionId, Mode=OneWay}"
                              SelectionChanged="GameProfile_SelectionChanged"
                              Height="36" VerticalAlignment="Center" Margin="12,0,12,0" Tag="Без профиля">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="FPS" IsReadOnly="True" Width="76">
                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FpsDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="СТАТУС" IsReadOnly="True" Width="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="8,5" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#24343E"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Applied"><Setter Property="Background" Value="#294239"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Background" Value="#482F38"/></DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Unsupported"><Setter Property="Background" Value="#443D31"/></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#D6E3E4"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="Здесь пока нет игр" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Импортируйте библиотеку Steam или добавьте игровой .exe вручную." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=GamesGrid}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </StackPanel.Style>
          </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="3" Padding="17">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
              <Style.Triggers><DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="НАЗВАНИЕ ИГРЫ" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/>
              <TextBox Text="{Binding SelectedGame.Name, UpdateSourceTrigger=LostFocus}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
              <TextBlock Text="СОСТОЯНИЕ" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/>
              <TextBlock Text="{Binding SelectedGame.Detail, TargetNullValue=Выберите игру в списке}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedGame.Detail}"/>
              <TextBlock Foreground="#BED8B0" FontSize="11" Margin="0,5,0,0">
                <Run Text="FPS "/><Run Text="{Binding SelectedGame.FpsDisplay}"/>
                <Run Text="  ·  VRR "/><Run Text="{Binding SelectedGame.VrrDisplay}"/>
                <Run Text="  ·  V-Sync "/><Run Text="{Binding SelectedGame.VSyncDisplay}"/>
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers><DataTrigger Binding="{Binding SelectedGame.ProfileId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding SelectedGame.ExeDisplay}" Foreground="#A0B1BF" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
              <Button Content="Выбрать .exe" Command="{Binding ChooseExeCommand}" Margin="0,0,7,0"/>
              <Button Content="Восстановить" Command="{Binding RestoreCommand}" IsEnabled="{Binding SelectedGameHasBackup}" Margin="0,0,7,0"/>
              <Button Content="Удалить" Style="{StaticResource DangerButton}" Command="{Binding RemoveGameCommand}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </TabItem>

    <TabItem Header="Профили" Tag="03">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="НАСТРОЙКИ ПРОИЗВОДИТЕЛЬНОСТИ" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
            <TextBlock Text="Профили" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Изменение общего профиля помечает связанные игры как «Ожидает»." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
          </StackPanel>
          <Button Grid.Column="1" Content="+ Создать профиль" Style="{StaticResource PrimaryButton}" Command="{Binding AddProfileCommand}" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="5,3,0,17">
                <TextBlock Text="ВАШИ ПРОФИЛИ" Style="{StaticResource Eyebrow}"/>
                <TextBlock Text="{Binding ProfileCount, StringFormat='Всего: {0}'}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
              </StackPanel>
              <Button DockPanel.Dock="Bottom" Content="Удалить выбранный" Style="{StaticResource DangerButton}" Command="{Binding RemoveProfileCommand}" Margin="0,15,0,0"/>
              <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemContainerStyle="{StaticResource ProfileItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding FpsLimit, StringFormat='{}{0} FPS'}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <TextBlock Text="{Binding VrrDisplay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="27">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="РЕДАКТОР ПРОФИЛЯ" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
                <TextBlock Text="{Binding SelectedProfile.Name, TargetNullValue=Выберите профиль}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Text="Параметры применятся ко всем играм, которым назначен этот профиль." Style="{StaticResource Muted}" Margin="0,0,0,29"/>
                <TextBlock Text="Название" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,19"/>
                <Grid Margin="0,0,0,19">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Лимит FPS" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding SelectedProfile.FpsLimit, UpdateSourceTrigger=LostFocus}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Технология монитора" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding VrrModes}" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile.Vrr, Mode=TwoWay}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <TextBlock Text="Вертикальная синхронизация" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding VSyncModes}" SelectedValuePath="Value" SelectedValue="{Binding SelectedProfile.VSync, Mode=TwoWay}" Margin="0,0,0,19">
                  <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding SelectedProfile.Description, UpdateSourceTrigger=LostFocus}"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </TabItem>

    <TabItem Header="Настройки" Tag="04">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
          <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource Eyebrow}" Margin="0,0,0,7"/>
          <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Подключения, поведение при запуске и резервная копия." Style="{StaticResource Muted}" Margin="0,5,0,25"/>

          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="01  /  ИНТЕГРАЦИЯ" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <TextBlock Text="RivaTuner Statistics Server" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Укажите папку RTSS. Если поле пустое, приложение найдёт её через реестр." Style="{StaticResource Muted}" Margin="0,7,0,19"/>
              <TextBlock Text="Папка установки" Style="{StaticResource FieldLabel}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding RtssDirectory, UpdateSourceTrigger=LostFocus}"/>
                <Button Grid.Column="2" Content="Обзор…" Command="{Binding BrowseRtssCommand}"/>
              </Grid>
              <TextBlock Text="{Binding RtssStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,13,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="02  /  СИСТЕМА" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <TextBlock Text="Поведение при запуске" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,20"/>
              <CheckBox Content="При запуске проверять и повторно применять настройки" IsChecked="{Binding CheckAtStartup}" Margin="0,0,0,7"/>
              <TextBlock Text="Сверяет сохранённые параметры с RTSS и NVIDIA. При расхождении применяет выбранные профили; для игр без профиля восстанавливает прежние параметры. Работает при запуске этого приложения." Style="{StaticResource Muted}" FontSize="12" Margin="30,0,0,17"/>
              <CheckBox Content="Запускать приложение при входе в Windows" IsChecked="{Binding AutoStart}" Margin="0,0,0,20"/>
              <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,17"/>
              <TextBlock Text="NVIDIA" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock Text="{Binding NvidiaStatus}" Style="{StaticResource Muted}" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="03  /  ДАННЫЕ" Style="{StaticResource Eyebrow}" Margin="0,0,0,8"/>
              <TextBlock Text="Резервная копия и диагностика" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="Папка с конфигурацией" Style="{StaticResource FieldLabel}" Margin="0,20,0,7"/>
              <TextBlock Text="{Binding DataDirectory}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
              <Button Content="Экспортировать копию JSON" Command="{Binding BackupCommand}" HorizontalAlignment="Left"/>
              <TextBlock Text="Исходные значения RTSS и NVIDIA сохраняются перед первой записью для каждого .exe. Восстановление доступно в разделе «Мои игры»." Style="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
