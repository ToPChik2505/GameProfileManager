<Application x:Class="GameProfileManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="AccentMetricValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SuccessMetricValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="CautionMetricValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <DataTemplate x:Key="GameRowTemplate">
      <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
              CornerRadius="8" Margin="0,0,0,8">
      <Grid Padding="12,10" ColumnSpacing="16" MinHeight="68">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="48"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="180"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="132"/>
        </Grid.ColumnDefinitions>
        <Border Width="48" Height="48" Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="9">
          <Grid>
            <FontIcon Glyph="&#xE7F1;" FontSize="21" />
            <Image Source="{Binding Icon}" Width="48" Height="48" Stretch="UniformToFill" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ExeName}" Style="{ThemeResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding ProfileDisplay}" Style="{ThemeResource BodyTextBlockStyle}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ProfileListDetail}" Style="{ThemeResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding FpsListDisplay}" VerticalAlignment="Center"
                   Style="{ThemeResource BodyTextBlockStyle}" />
        <Border Grid.Column="4" Background="{ThemeResource ControlFillColorDefaultBrush}"
                CornerRadius="6" Padding="8,5" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusLabel}" HorizontalAlignment="Center"
                     Style="{ThemeResource CaptionTextBlockStyle}" />
        </Border>
      </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ProfileRowTemplate">
      <Grid Padding="12,10" ColumnSpacing="12" MinHeight="62">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding ListDetail}" Style="{ThemeResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding FpsPreview}" VerticalAlignment="Center"
                   Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
