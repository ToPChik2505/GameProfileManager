<Window x:Class="GameProfileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
  <Grid x:Name="RootLayout" Background="Transparent" XYFocusKeyboardNavigation="Enabled">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar">
      <TitleBar.LeftHeader>
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,0,0,0" VerticalAlignment="Center">
          <Button x:Name="PaneToggleButton" Width="40" Height="40" Padding="0"
                  Background="Transparent" BorderThickness="0"
                  AutomationProperties.Name="Свернуть или развернуть боковое меню"
                  Click="PaneToggleButton_Click">
            <FontIcon Glyph="&#xE700;" FontSize="20" />
          </Button>
          <Image Source="ms-appx:///Assets/GpmBranding/PNG/gpm_dark_128.png"
                 Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center"
                 IsHitTestVisible="False" />
          <TextBlock Text="GPM" Style="{ThemeResource BodyTextBlockStyle}" FontWeight="SemiBold"
                     VerticalAlignment="Center" IsHitTestVisible="False" />
          <TextBlock x:Name="AppTitleFullName" Text="Game Profile Manager"
                     Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.78"
                     IsHitTestVisible="False"
                     VerticalAlignment="Center" />
        </StackPanel>
      </TitleBar.LeftHeader>
    </TitleBar>
    <NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="Auto"
                    OpenPaneLength="248" CompactPaneLength="64"
                    IsPaneToggleButtonVisible="False"
                    IsBackButtonVisible="Visible" IsBackEnabled="False" IsSettingsVisible="True"
                    SelectionChanged="NavView_SelectionChanged"
                    BackRequested="NavView_BackRequested">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Обзор" Tag="overview" Icon="Home" />
        <NavigationViewItem Content="Мои игры" Tag="games" Icon="Library" />
        <NavigationViewItem Content="Профили" Tag="profiles" Icon="Contact" />
        <NavigationViewItem Content="Мониторы" Tag="monitors" Icon="View" />
        <NavigationViewItem Content="Диагностика" Tag="diagnostics" Icon="ReportHacked" />
      </NavigationView.MenuItems>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="8" Margin="16,8,16,0">
          <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
          <InfoBar x:Name="RtssBar" Title="RTSS закрыт" Severity="Warning" IsOpen="False" IsClosable="False">
            <InfoBar.ActionButton>
              <Button x:Name="StartRtssButton" Content="Запустить RTSS" Click="StartRtssButton_Click" />
            </InfoBar.ActionButton>
          </InfoBar>
          <Border x:Name="ActivityBanner" Visibility="Collapsed" Padding="12,8"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ProgressRing x:Name="ActivityRing" Width="24" Height="24" IsActive="False" />
              <TextBlock x:Name="ActivityText" VerticalAlignment="Center" TextWrapping="Wrap"
                         Style="{ThemeResource BodyTextBlockStyle}" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Frame x:Name="ContentFrame" Grid.Row="1" />
        <TextBlock x:Name="ControllerLegend" Grid.Row="2" Text="A — выбрать     B — назад     LB/RB — разделы     D-pad — перемещение"
                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="24,8,24,12" Visibility="Collapsed" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
